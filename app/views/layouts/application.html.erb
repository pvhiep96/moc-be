<!DOCTYPE html>
<html lang="vi">
  <head>
    <title>MOC Productions — Studio Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>

    <%= javascript_importmap_tags %>
    <%= tinymce_assets %>
    <%= tinymce %>

    <style>
      :root {
        --admin-bg: #f1f5f9;
        --admin-sidebar: #0f172a;
        --admin-accent: #2563eb;
      }

      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background-color: var(--admin-bg);
        color: #1e293b;
      }

      .admin-navbar {
        background-color: #090d16;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        padding: 0.55rem 1.25rem;
      }

      .sidebar {
        min-height: calc(100vh - 57px);
        background-color: var(--admin-sidebar);
        border-right: 1px solid rgba(255, 255, 255, 0.06);
      }

      .sidebar .nav-link {
        color: rgba(255, 255, 255, 0.78);
        border-radius: 0.6rem;
        margin: 0.2rem 0;
        padding: 0.68rem 0.9rem;
        font-size: 0.88rem;
        font-weight: 500;
        transition: all 0.15s ease;
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }

      .sidebar .nav-link:hover {
        color: #fff;
        background-color: rgba(255, 255, 255, 0.08);
      }

      .sidebar .nav-link.active {
        color: #fff;
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35);
      }

      .sidebar .sidebar-heading {
        color: rgba(255, 255, 255, 0.45);
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: 1.1rem 0.9rem 0.35rem;
      }

      .main-content {
        min-height: calc(100vh - 57px);
      }

      .card {
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06), 0 1px 2px rgba(15, 23, 42, 0.04);
        border: 1px solid rgba(15, 23, 42, 0.08);
        border-radius: 0.85rem;
      }

      .card-header {
        background-color: #fff;
        border-bottom: 1px solid rgba(15, 23, 42, 0.07);
        padding: 0.9rem 1.25rem;
        border-top-left-radius: 0.85rem !important;
        border-top-right-radius: 0.85rem !important;
      }

      .project-thumb {
        width: 68px;
        height: 52px;
        object-fit: cover;
        border-radius: 0.45rem;
        background-color: #e2e8f0;
        border: 1px solid rgba(0, 0, 0, 0.08);
      }

      .project-thumb-placeholder {
        width: 68px;
        height: 52px;
        border-radius: 0.45rem;
        background-color: #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #94a3b8;
      }

      .stat-card {
        border-radius: 0.85rem;
        background: #fff;
        padding: 1.1rem 1.25rem;
        border: 1px solid rgba(15, 23, 42, 0.07);
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
      }

      .sticky-workspace-bar {
        position: sticky;
        top: 57px;
        z-index: 1010;
        background: rgba(255, 255, 255, 0.94);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(15, 23, 42, 0.09);
        margin: -1.5rem -1.5rem 1.5rem -1.5rem;
        padding: 0.85rem 1.5rem;
      }

      /* Tab điều hướng 3 trang chính */
      .page-switcher-pills .nav-link {
        border-radius: 0.65rem;
        font-weight: 600;
        font-size: 0.86rem;
        padding: 0.45rem 0.9rem;
        color: rgba(255, 255, 255, 0.78);
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: rgba(255, 255, 255, 0.04);
      }

      .page-switcher-pills .nav-link:hover {
        color: #fff;
        background: rgba(255, 255, 255, 0.1);
      }

      .page-switcher-pills .nav-link.active {
        color: #fff;
        background: #2563eb;
        border-color: #3b82f6;
      }
    </style>
  </head>

  <body>
    <% is_studio_mgr = controller_name == 'projects' && action_name == 'studio_manager' %>
    <% is_detail_mgr = controller_name == 'projects' && %w[edit show manage_content detail_manager new].include?(action_name) %>
    <% is_index_mgr = controller_name == 'projects' && action_name == 'index' %>

    <!-- Top Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark admin-navbar sticky-top">
      <div class="container-fluid">
        <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="<%= projects_path %>">
          <span class="badge bg-primary rounded-2 p-2"><i class="fas fa-clapperboard"></i></span>
          <span>MOC Website Builder</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav me-auto ms-lg-3 gap-2 page-switcher-pills align-items-lg-center">
            <% if admin_logged_in? %>
              <li class="nav-item">
                <%= link_to site_editor_path, class: "nav-link" do %>
                  <i class="fas fa-pen-ruler text-warning me-1"></i> Sửa giao diện website
                <% end %>
              </li>
              <li class="nav-item">
                <%= link_to projects_path, class: "nav-link #{controller_name == 'projects' ? 'active' : ''}" do %>
                  <i class="fas fa-film text-info me-1"></i> Dự án
                <% end %>
              </li>
              <li class="nav-item ms-lg-2">
                <%= link_to inquiries_path, class: "nav-link #{controller_name == 'inquiries' ? 'active' : ''}" do %>
                  <i class="fas fa-envelope-open-text me-1"></i> Liên hệ
                  <% inquiry_count = Inquiry.count rescue 0 %>
                  <% if inquiry_count.positive? %>
                    <span class="badge rounded-pill bg-info text-dark ms-1"><%= inquiry_count %></span>
                  <% end %>
                <% end %>
              </li>
            <% end %>
          </ul>

          <ul class="navbar-nav align-items-lg-center gap-2">
            <% if admin_logged_in? %>
              <li class="nav-item">
                <a class="btn btn-sm btn-outline-light fw-semibold" href="<%= frontend_url('/') %>" target="_blank" rel="noopener">
                  Xem website ↗
                </a>
              </li>
              <li class="nav-item dropdown ms-lg-1">
                <a class="nav-link dropdown-toggle text-light" href="#" role="button" data-bs-toggle="dropdown">
                  <i class="fas fa-user-shield me-1"></i> <%= current_admin.fullname.presence || current_admin.user_name %>
                </a>
                <ul class="dropdown-menu dropdown-menu-end shadow">
                  <li>
                    <%= button_to logout_path, method: :delete, class: "dropdown-item text-danger" do %>
                      <i class="fas fa-sign-out-alt me-1"></i> Đăng xuất
                    <% end %>
                  </li>
                </ul>
              </li>
            <% else %>
              <li class="nav-item">
                <%= link_to login_path, class: "btn btn-sm btn-outline-light" do %>
                  <i class="fas fa-sign-in-alt me-1"></i> Đăng nhập
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>

    <div class="container-fluid">
      <div class="row">
        <% if admin_logged_in? %>
          <!-- Sidebar -->
          <div class="col-md-3 col-lg-2 d-md-block sidebar collapse">
            <div class="position-sticky pt-2">
              <div class="sidebar-heading">Sửa giao diện theo trang</div>
              <ul class="nav flex-column px-2">
                <% SiteContent.content_pages.each do |page| %>
                  <li class="nav-item">
                    <%= link_to site_editor_path(page: page['id']), class: "nav-link" do %>
                      <i class="fas <%= page['icon'] %>"></i>
                      <div>
                        <div class="fw-bold"><%= page['name'] %></div>
                        <div style="font-size: 0.72rem; opacity: 0.6;"><%= page['path'] %></div>
                      </div>
                    <% end %>
                  </li>
                <% end %>
              </ul>

              <div class="sidebar-heading">Quản lý chung</div>
              <ul class="nav flex-column px-2">
                <li class="nav-item">
                  <%= link_to projects_path, class: "nav-link #{is_index_mgr ? 'active' : ''}" do %>
                    <i class="fas fa-film"></i> Danh sách dự án
                  <% end %>
                </li>
                <li class="nav-item">
                  <%= link_to new_project_path, class: "nav-link #{controller_name == 'projects' && action_name == 'new' ? 'active' : ''}" do %>
                    <i class="fas fa-plus-circle text-success"></i> + Thêm dự án mới
                  <% end %>
                </li>
                <li class="nav-item">
                  <%= link_to inquiries_path, class: "nav-link #{controller_name == 'inquiries' ? 'active' : ''}" do %>
                    <i class="fas fa-inbox"></i> Hộp thư khách hàng
                  <% end %>
                </li>
              </ul>

              <div class="sidebar-heading">Hướng dẫn nhanh</div>
              <div class="px-3 py-2 small" style="color: rgba(255,255,255,.62); line-height: 1.55;">
                <div class="mb-2"><strong class="text-warning">• Chữ, link, ảnh trên các trang:</strong> mở <em>Sửa giao diện</em>, click thẳng vào chỗ muốn sửa trên trang xem trước.</div>
                <div><strong class="text-info">• Ảnh, video, mô tả từng cặp đôi:</strong> vào <em>Danh sách dự án</em> → chọn dự án.</div>
              </div>
            </div>
          </div>

          <!-- Main content -->
          <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4 main-content">
            <%= render 'layouts/flash_messages' %>
            <%= yield %>
          </main>
        <% else %>
          <main class="col-12 px-4 py-4">
            <%= render 'layouts/flash_messages' %>
            <%= yield %>
          </main>
        <% end %>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
