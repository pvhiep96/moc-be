<!-- Header trang dự án -->
<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
  <div>
    <h3 class="fw-bold mb-1">Dự án</h3>
    <p class="text-muted mb-0">Ảnh, video, mô tả và thứ tự hiển thị của từng cặp đôi.</p>
  </div>
  <div class="d-flex gap-2 flex-wrap">
    <%= link_to new_project_path, class: "btn btn-success fw-semibold shadow-sm" do %>
      <i class="fas fa-plus-circle me-2"></i>Thêm dự án mới
    <% end %>
  </div>
</div>

<!-- Lối vào trình sửa giao diện trực quan -->
<div class="card border-primary border-2 mb-4">
  <div class="card-body d-flex flex-wrap align-items-center gap-3">
    <div class="fs-2 text-primary"><i class="fas fa-pen-ruler"></i></div>
    <div class="flex-grow-1" style="min-width: 260px;">
      <div class="fw-bold">Muốn sửa chữ, link, ảnh trên một trang của website?</div>
      <div class="small text-muted">
        Mở <strong>Sửa giao diện website</strong>: trang thật hiện bên trái, <strong>click vào đúng chỗ muốn sửa</strong>
        → ô nhập tương ứng hiện ra bên phải, gõ là thấy ngay.
      </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <% SiteContent.content_pages.each do |page| %>
        <%= link_to site_editor_path(page: page['id']), class: "btn btn-sm #{page['id'] == 'home' ? 'btn-primary' : 'btn-outline-primary'}" do %>
          <i class="fas <%= page['icon'] %> me-1"></i><%= page['name'] %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<!-- =========================================================================
     DANH SÁCH CÁC DỰ ÁN CƯỚI HIỆN CÓ — CHỌN NHANH ĐỂ SỬA TRÊN TỪNG TRANG
     ========================================================================= -->
<div class="card shadow-sm">
  <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
      <h5 class="fw-bold mb-0">Danh Sách Dự Án Cưới Hiện Có (<%= @stats[:total_projects] %> dự án)</h5>
      <div class="small text-muted">Chọn sửa dự án trên <strong>Trang Studio (/studio)</strong> hoặc <strong>Trang Chi Tiết (/projects/[id])</strong></div>
    </div>
    <%= link_to new_project_path, class: "btn btn-sm btn-primary fw-semibold" do %>
      <i class="fas fa-plus me-1"></i>+ Thêm Dự Án Mới
    <% end %>
  </div>

  <div class="card-body">
    <div class="row g-3">
      <% @projects.each do |project| %>
        <% disp = project.displayed_images %>
        <% cover = disp.first || project.project_images.first %>
        <% hover = disp.second || cover %>

        <div class="col-12 col-md-6 col-xl-4">
          <div class="card h-100 border">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
              <h6 class="fw-bold mb-0 text-truncate"><%= project.name %></h6>
              <span class="badge bg-dark">#<%= project.id %></span>
            </div>

            <div class="card-body">
              <div class="row g-2 mb-3">
                <div class="col-6">
                  <div class="position-relative rounded overflow-hidden bg-dark border border-warning" style="height: 110px;">
                    <% if cover %>
                      <img src="<%= cover.image_url %>" class="w-100 h-100" style="object-fit: cover;" alt="">
                    <% end %>
                    <span class="position-absolute top-0 start-0 m-1 badge bg-warning text-dark" style="font-size: 9px;">
                      ★ Ảnh Bìa (#1)
                    </span>
                  </div>
                </div>
                <div class="col-6">
                  <div class="position-relative rounded overflow-hidden bg-dark border border-info" style="height: 110px;">
                    <% if hover %>
                      <img src="<%= hover.image_url %>" class="w-100 h-100" style="object-fit: cover;" alt="">
                    <% end %>
                    <span class="position-absolute top-0 start-0 m-1 badge bg-info text-dark" style="font-size: 9px;">
                      ✦ Ảnh Hover (#2)
                    </span>
                  </div>
                </div>
              </div>

              <div class="d-flex justify-content-between small text-muted mb-3">
                <span><i class="fas fa-images text-primary me-1"></i><%= disp.size %> ảnh hiển thị</span>
                <span><i class="fas fa-film text-danger me-1"></i><%= project.video_urls.size %> phim cưới</span>
                <span><i class="fas fa-align-left text-success me-1"></i><%= project.descriptions.size %> mô tả</span>
              </div>

              <div class="d-grid gap-2">
                <%= link_to studio_manager_projects_path(project_id: project.id), class: "btn btn-sm btn-outline-info text-dark fw-semibold" do %>
                  <i class="fas fa-table-cells-large me-1"></i>Đổi ảnh bìa / ảnh hover / video dọc
                <% end %>

                <%= link_to edit_project_path(project), class: "btn btn-sm btn-success fw-semibold" do %>
                  <i class="fas fa-film me-1"></i>Sửa nội dung dự án (mô tả, video, album)
                <% end %>

                <div class="d-flex gap-2 mt-1">
                  <a href="<%= frontend_url("/projects/#{project.id}") %>" target="_blank" rel="noopener"
                     class="btn btn-sm btn-light border flex-fill small">
                    Xem trên Web ↗
                  </a>
                  <%= button_to project_path(project),
                      method: :delete,
                      form: { data: { turbo_confirm: "Xóa vĩnh viễn dự án \"#{project.name}\"?" } },
                      class: "btn btn-sm btn-outline-danger" do %>
                    <i class="fas fa-trash"></i>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
