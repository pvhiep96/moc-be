<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
  <div>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><%= link_to 'Dự án', projects_path %></li>
        <li class="breadcrumb-item"><%= link_to @project.name, @project %></li>
        <li class="breadcrumb-item active" aria-current="page">Sắp xếp nội dung</li>
      </ol>
    </nav>
    <h2 class="mt-2 mb-0">Sắp xếp nội dung hiển thị</h2>
  </div>
  <%= link_to project_path(@project), class: 'btn btn-outline-secondary' do %>
    <i class="fas fa-arrow-left me-1"></i> Về trang dự án
  <% end %>
</div>

<div data-controller="content-order"
     data-content-order-url-value="<%= update_content_positions_project_path(@project) %>">

  <!-- Khu 1: Nội dung đang hiển thị trên website -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
      <div>
        <h5 class="mb-0"><i class="fas fa-eye me-2 text-success"></i>Đang hiển thị trên website</h5>
        <p class="text-muted mb-0 small">
          Kéo <i class="fas fa-grip-vertical mx-1"></i> để đổi thứ tự (trên cùng hiển thị trước).
          Mọi thay đổi được <strong>lưu tự động</strong>.
        </p>
      </div>
      <div data-content-order-target="status"></div>
    </div>
    <div class="card-body">
      <div id="sortable-content" data-content-order-target="sorted">
        <% @content_items.each_with_index do |item, index| %>
          <%= render 'content_order_item', content: item[:content], type: item[:type], position: index + 1 %>
        <% end %>
      </div>

      <div class="alert alert-warning mb-0 <%= 'd-none' if @content_items.present? %>"
           data-content-order-target="sortedEmpty">
        <i class="fas fa-triangle-exclamation me-2"></i>
        Chưa có nội dung nào được hiển thị — website sẽ không có gì để xem ở dự án này.
        Bấm nút <strong>"+ Hiển thị"</strong> ở khu bên dưới để thêm ảnh, video hoặc mô tả.
      </div>
    </div>
  </div>

  <!-- Khu 2: Nội dung chưa hiển thị -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3">
      <h5 class="mb-0"><i class="fas fa-eye-slash me-2 text-muted"></i>Chưa hiển thị</h5>
      <p class="text-muted mb-0 small">Nội dung đã có trong dự án nhưng chưa được đưa lên website. Bấm <strong>"+ Hiển thị"</strong> để thêm vào danh sách phía trên.</p>
    </div>
    <div class="card-body">
      <ul class="nav nav-tabs" id="unorderedContentTab" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link active" id="pool-images-tab" data-bs-toggle="tab" data-bs-target="#pool-images" type="button" role="tab">
            <i class="fas fa-image me-1"></i> Ảnh (<span data-tab-count="ProjectImage"><%= @unordered_images.count %></span>)
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="pool-descriptions-tab" data-bs-toggle="tab" data-bs-target="#pool-descriptions" type="button" role="tab">
            <i class="fas fa-align-left me-1"></i> Mô tả (<span data-tab-count="Description"><%= @unordered_descriptions.count %></span>)
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="pool-videos-tab" data-bs-toggle="tab" data-bs-target="#pool-videos" type="button" role="tab">
            <i class="fas fa-video me-1"></i> Video (<span data-tab-count="VideoUrl"><%= @unordered_videos.count %></span>)
          </button>
        </li>
      </ul>

      <div class="tab-content p-3 border border-top-0 rounded-bottom">
        <div class="tab-pane fade show active" id="pool-images" role="tabpanel">
          <div class="row g-3" data-unsorted-container="ProjectImage">
            <% @unordered_images.each do |image| %>
              <%= render 'content_pool_item', content: image, type: 'ProjectImage' %>
            <% end %>
          </div>
          <div class="alert alert-light border mb-0 mt-2 <%= 'd-none' if @unordered_images.present? %>"
               data-unsorted-empty="ProjectImage">
            <i class="fas fa-check-circle me-2 text-success"></i>Tất cả ảnh đều đang được hiển thị.
          </div>
        </div>

        <div class="tab-pane fade" id="pool-descriptions" role="tabpanel">
          <div class="row g-3" data-unsorted-container="Description">
            <% @unordered_descriptions.each do |description| %>
              <%= render 'content_pool_item', content: description, type: 'Description' %>
            <% end %>
          </div>
          <div class="alert alert-light border mb-0 mt-2 <%= 'd-none' if @unordered_descriptions.present? %>"
               data-unsorted-empty="Description">
            <i class="fas fa-check-circle me-2 text-success"></i>Tất cả mô tả đều đang được hiển thị.
          </div>
        </div>

        <div class="tab-pane fade" id="pool-videos" role="tabpanel">
          <div class="row g-3" data-unsorted-container="VideoUrl">
            <% @unordered_videos.each do |video| %>
              <%= render 'content_pool_item', content: video, type: 'VideoUrl' %>
            <% end %>
          </div>
          <div class="alert alert-light border mb-0 mt-2 <%= 'd-none' if @unordered_videos.present? %>"
               data-unsorted-empty="VideoUrl">
            <i class="fas fa-check-circle me-2 text-success"></i>Tất cả video đều đang được hiển thị.
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Kho ẩn: bản render sẵn ở dạng còn lại của mỗi item, JS chỉ di chuyển node qua lại -->
  <div class="d-none" data-content-order-target="sortedPool">
    <% @unordered_images.each do |image| %>
      <%= render 'content_order_item', content: image, type: 'ProjectImage', position: nil %>
    <% end %>
    <% @unordered_descriptions.each do |description| %>
      <%= render 'content_order_item', content: description, type: 'Description', position: nil %>
    <% end %>
    <% @unordered_videos.each do |video| %>
      <%= render 'content_order_item', content: video, type: 'VideoUrl', position: nil %>
    <% end %>
  </div>

  <div class="d-none" data-content-order-target="unsortedPool">
    <% @content_items.each do |item| %>
      <%= render 'content_pool_item', content: item[:content], type: item[:type] %>
    <% end %>
  </div>
</div>

<style>
  .drag-handle {
    cursor: grab;
  }

  .sortable-ghost {
    opacity: 0.4;
    background-color: #f8f9fa;
  }

  .description-content {
    max-height: 150px;
    overflow-y: auto;
  }
</style>
