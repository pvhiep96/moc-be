<div class="nested-fields card mb-3 border">
  <div class="card-body py-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <label class="form-label fw-semibold mb-0">Nội dung mô tả</label>
      <% if f.object.persisted? %>
        <%= f.hidden_field :_destroy %>
      <% end %>
      <button type="button" class="btn btn-outline-danger btn-sm" title="Xóa mô tả này"
              data-action="nested-form#remove">
        <i class="fas fa-trash me-1"></i>Xóa
      </button>
    </div>
    <%= f.text_area :content, class: 'form-control tinymce', rows: 5 %>
    <div class="form-text">Dùng thanh công cụ phía trên để định dạng chữ, chèn ảnh, tạo bảng…</div>

    <% if f.object.errors[:content].any? %>
      <div class="alert alert-danger py-2 mt-2 mb-0">
        <% f.object.errors[:content].each do |error| %>
          <div><i class="fas fa-exclamation-circle me-1"></i> <%= error %></div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
