<div class="row justify-content-center align-items-center" style="min-height: 70vh;">
  <div class="col-md-5 col-lg-4">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <div class="text-center mb-4">
          <i class="fas fa-clapperboard fa-2x text-primary mb-2"></i>
          <h1 class="h4 mb-1">MOC Productions</h1>
          <p class="text-muted small mb-0">Đăng nhập trang quản trị</p>
        </div>

        <%= form_with url: sessions_path, local: true do |form| %>
          <div class="form-group mb-3">
            <%= form.label :user_name, "Tên đăng nhập", class: "form-label" %>
            <%= form.text_field :user_name, class: 'form-control', required: true, autofocus: true, autocomplete: "username" %>
          </div>

          <div class="form-group mb-4">
            <%= form.label :password, "Mật khẩu", class: "form-label" %>
            <%= form.password_field :password, class: 'form-control', required: true, autocomplete: "current-password" %>
          </div>

          <div class="d-grid">
            <%= form.submit "Đăng nhập", class: 'btn btn-primary' %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
