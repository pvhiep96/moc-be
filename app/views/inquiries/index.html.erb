<div class="container-fluid px-2 py-2">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
      <h2 class="fw-bold mb-1">Hộp thư Khách liên hệ (Inquiries)</h2>
      <p class="text-muted mb-0">Danh sách yêu cầu báo giá và đặt lịch khách gửi từ trang Contact</p>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white">
      <div class="row g-2 align-items-center justify-content-between">
        <div class="col-12 col-md-6">
          <%= form_with url: inquiries_path, method: :get, local: true, class: "d-flex gap-2" do %>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0"><i class="fas fa-search text-muted"></i></span>
              <input type="search" name="q" value="<%= params[:q] %>" class="form-control border-start-0"
                     placeholder="Tìm theo tên khách, email, loại sự kiện, nội dung…">
            </div>
            <button type="submit" class="btn btn-primary px-3">Tìm</button>
            <% if params[:q].present? %>
              <%= link_to "Xóa lọc", inquiries_path, class: "btn btn-outline-secondary" %>
            <% end %>
          <% end %>
        </div>
        <div class="col-auto text-muted small">
          Tổng cộng <strong><%= @inquiries.total_count %></strong> liên hệ
        </div>
      </div>
    </div>

    <div class="card-body p-0">
      <% if @inquiries.any? %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="px-4 py-3">Khách hàng</th>
                <th class="px-3 py-3">Sự kiện & Ngày</th>
                <th class="px-3 py-3">Ngân sách</th>
                <th class="px-3 py-3">Lời nhắn</th>
                <th class="px-3 py-3">Ngày gửi</th>
                <th class="px-4 py-3 text-end">Thao tác</th>
              </tr>
            </thead>
            <tbody>
              <% @inquiries.each do |inquiry| %>
                <tr>
                  <td class="px-4 py-3">
                    <div class="fw-semibold">
                      <%= link_to inquiry.full_name, inquiry_path(inquiry), class: "text-decoration-none text-dark" %>
                    </div>
                    <div class="small">
                      <a href="mailto:<%= inquiry.email %>" class="text-muted text-decoration-none">
                        <i class="fas fa-envelope me-1"></i><%= inquiry.email %>
                      </a>
                    </div>
                    <% if inquiry.instagram.present? %>
                      <div class="small text-muted">
                        <i class="fab fa-instagram me-1"></i><%= inquiry.instagram %>
                      </div>
                    <% end %>
                  </td>
                  <td class="px-3 py-3">
                    <% if inquiry.event_type.present? %>
                      <span class="badge bg-primary-subtle text-primary border border-primary-subtle mb-1">
                        <%= inquiry.event_type %>
                      </span>
                    <% end %>
                    <div class="small text-muted">
                      <% if inquiry.event_date.present? %>
                        <i class="fas fa-calendar-day me-1"></i><%= inquiry.event_date.strftime("%d/%m/%Y") %>
                      <% end %>
                      <% if inquiry.event_location.present? %>
                        <div><i class="fas fa-location-dot me-1"></i><%= inquiry.event_location %></div>
                      <% end %>
                    </div>
                  </td>
                  <td class="px-3 py-3">
                    <% if inquiry.budget.present? %>
                      <span class="badge bg-success-subtle text-success border border-success-subtle">
                        <%= inquiry.budget %>
                      </span>
                    <% else %>
                      <span class="text-muted small">—</span>
                    <% end %>
                  </td>
                  <td class="px-3 py-3" style="max-width: 300px;">
                    <div class="small text-muted text-truncate">
                      <%= inquiry.message %>
                    </div>
                  </td>
                  <td class="px-3 py-3 text-muted small">
                    <%= inquiry.created_at.strftime("%d/%m/%Y %H:%M") %>
                  </td>
                  <td class="px-4 py-3 text-end">
                    <div class="d-inline-flex gap-2">
                      <%= link_to inquiry_path(inquiry), class: "btn btn-sm btn-outline-primary" do %>
                        <i class="fas fa-eye me-1"></i>Chi tiết
                      <% end %>
                      <%= button_to inquiry_path(inquiry),
                          method: :delete,
                          class: "btn btn-sm btn-outline-danger",
                          form: { data: { turbo_confirm: "Xóa liên hệ của \"#{inquiry.full_name}\"?" } } do %>
                        <i class="fas fa-trash"></i>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <% if @inquiries.total_pages > 1 %>
          <div class="card-footer bg-white py-3">
            <nav aria-label="Phân trang">
              <ul class="pagination pagination-sm justify-content-center mb-0">
                <li class="page-item <%= 'disabled' unless @inquiries.prev_page %>">
                  <%= link_to raw('&lsaquo; Trước'), inquiries_path(q: params[:q], page: @inquiries.prev_page), class: 'page-link' %>
                </li>
                <% (1..@inquiries.total_pages).each do |page| %>
                  <li class="page-item <%= 'active' if page == @inquiries.current_page %>">
                    <%= link_to page, inquiries_path(q: params[:q], page: page), class: 'page-link' %>
                  </li>
                <% end %>
                <li class="page-item <%= 'disabled' unless @inquiries.next_page %>">
                  <%= link_to raw('Sau &rsaquo;'), inquiries_path(q: params[:q], page: @inquiries.next_page), class: 'page-link' %>
                </li>
              </ul>
            </nav>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-5">
          <i class="fas fa-inbox fa-2x text-muted mb-3"></i>
          <h5>Chưa có liên hệ nào</h5>
          <p class="text-muted mb-0">Khi khách hàng gửi form tại trang Contact, thông tin sẽ xuất hiện tại đây.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
